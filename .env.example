# Copy to .env.local (git-ignored) and fill from Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check reCAPTCHA v3 SITE key. The SECRET key lives only in the Firebase console.
VITE_RECAPTCHA_V3_SITE_KEY=
# Set to "off" for local runs while App Check isn't configured.
VITE_APPCHECK=
