# Copy to .env.local (git-ignored) and fill from Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check, pick one. Preferred: reCAPTCHA Enterprise site key (Firebase console -> App Check).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Or a registered App Check debug token (accepted by the hackathon rules). Empty in dev = print one.
VITE_APPCHECK_DEBUG_TOKEN=
# Legacy reCAPTCHA v3 site key (deprecated in Firebase App Check for new keys).
VITE_RECAPTCHA_V3_SITE_KEY=
# Set to "off" to disable App Check for a local run.
VITE_APPCHECK=
