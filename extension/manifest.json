{
  "manifest_version": 3,
  "name": "OneOf — check before you post",
  "short_name": "OneOf",
  "version": "0.1.0",
  "description": "While you write on Reddit, shows how identifiable the draft makes you. Read on-device with Gemini Nano; nothing is sent.",
  "minimum_chrome_version": "138",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://www.reddit.com/*", "https://old.reddit.com/*", "https://sh.reddit.com/*"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_title": "Open OneOf",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://www.reddit.com/*", "https://old.reddit.com/*", "https://sh.reddit.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-src 'none'; form-action 'none'; base-uri 'none'"
  }
}
